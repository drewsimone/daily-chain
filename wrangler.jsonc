{
  "name": "daily-chain",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-chain",
      "database_id": "d0a5c466-53c6-4ac9-91a4-8ceaffec0112"
    }
  ]
}
