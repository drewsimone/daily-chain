{
  "name": "daily-chain",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-chain",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
